  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@streamdown/cjk": "1.0.3",
    "@streamdown/code": "1.1.1",
    "@streamdown/math": "1.0.2",
    "@streamdown/mermaid": "1.0.2",
    "@vercel/sandbox": "3.3.0",
    "next": "16.3.5",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "streamdown": "2.6.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.9.0"
  }
