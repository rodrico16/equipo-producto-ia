{
  "name": "equipo-producto-ia-control-room",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "validate:runner": "node scripts/validate-runner.mjs",
    "validate:assignment-bridge": "node scripts/validate-codex-assignment-bridge.mjs",
