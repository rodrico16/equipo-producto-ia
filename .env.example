# GitHub OAuth App
# Local callback: http://localhost:3000/api/auth/callback
# Production callback: https://YOUR_DOMAIN/api/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# At least 32 characters. Used to encrypt the httpOnly GitHub session cookie.
SESSION_SECRET=

# ChatGPT / Codex uses Sign in with ChatGPT through Codex device authorization.
# No OPENAI_API_KEY or ChatGPT token is required in Vercel.
