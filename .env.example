# GitHub OAuth App
# Local callback: http://localhost:3000/api/auth/callback
# Production callback: https://YOUR_DOMAIN/api/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# At least 32 characters. Used to encrypt the httpOnly GitHub session cookie.
SESSION_SECRET=

# Vercel Sandbox authenticates automatically with Vercel OIDC in deployments.
# These are only needed for local development if OIDC is not available.
VERCEL_TOKEN=
VERCEL_TEAM_ID=
VERCEL_PROJECT_ID=
